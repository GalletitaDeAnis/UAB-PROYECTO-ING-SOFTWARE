@startuml casos-de-uso
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 140
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #1A5276
  FontSize 13
}
skinparam rectangle {
  BorderColor #1A365D
  FontSize 15
}
left to right direction

title Casos de uso (backlog v2)\nSistema de reservas del restaurante · Unión Boliviana

actor "Empleado\n(titular)" as Emp
actor "Encargado del\nrestaurante" as Enc
actor "API del sistema\nempresarial" as API <<sistema>>

rectangle "Sistema de reservas" {
  usecase "CU01 Iniciar sesión\n(HU01)" as CU01
  usecase "CU02 Reservar almuerzo propio\n(HU02)" as CU02
  usecase "CU03 Cancelar reserva propia\n(HU03)" as CU03
  usecase "CU05 Consultar familiares\n(HU05)" as CU05
  usecase "CU06 Reservar para familiar\n(HU06)" as CU06
  usecase "CU08 Pensionarse\n(HU08)" as CU08
  usecase "CU09 Pensionar familiar\n(HU09)" as CU09
  usecase "CU10 Avisar inasistencia\n(HU10)" as CU10
  usecase "CU13 Consultar consumo\npropio y familiar (HU12)" as CU13

  usecase "CU04 Ver almuerzos del día\n(HU04)" as CU04
  usecase "CU07 Registrar feriados\n(HU07)" as CU07
  usecase "CU11 Generar reporte mensual\npor titular (HU11)" as CU11
  usecase "CU12 Exportar reporte\n(Excel / PDF)" as CU12

  usecase "Registrar almuerzos\ndel mes" as RAM #F3E8FA
  usecase "Validar hora límite\n(antes de las 9:00)" as VHL #F3E8FA
}

Emp --> CU01
Emp --> CU02
Emp --> CU03
Emp --> CU05
Emp --> CU06
Emp --> CU08
Emp --> CU09
Emp --> CU10
Emp --> CU13

CU04 <-- Enc
CU07 <-- Enc
CU11 <-- Enc
CU01 <-- Enc

CU01 --> API
CU05 --> API

CU08 ..> RAM : <<include>>
CU09 ..> RAM : <<include>>
CU02 ..> VHL : <<include>>
CU03 ..> VHL : <<include>>
CU06 ..> VHL : <<include>>
CU10 ..> VHL : <<include>>
CU12 ..> CU11 : <<extend>>\n(si elige exportar)

note bottom of CU06
  El familiar no es actor: no ingresa (R9).
  El empleado elige a una persona
  de la lista de CU05 (R11).
end note
@enduml
