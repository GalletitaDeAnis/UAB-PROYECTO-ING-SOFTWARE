@startuml clases
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 140
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam linetype ortho

skinparam class {
  BackgroundColor #F8FBFF
  BorderColor #1A5276
  HeaderBackgroundColor #D6EAF8
  FontSize 13
  AttributeFontSize 12
}

title Diagrama de clases (backlog v2)\nSistema de Reservas y Pensionamiento de Almuerzos

abstract class Persona <<copia de la API empresarial>> {
  id : Texto
  nombreCompleto : Texto
  vigente : Booleano
}

class Empleado {
  codigoInstitucional : Texto
}

class Familiar {
  parentesco : Texto
}

class Autorizacion {
  rol : Rol
}

enum Rol {
  EMPLEADO
  ENCARGADO
}

class Sesion {
  tokenHash : Texto
  ultimaActividad : FechaHora
}

class Pension {
  anio : Entero
  mes : Entero
  solicitadaEl : Fecha
}

class Almuerzo {
  fecha : Fecha
  origen : OrigenAlmuerzo
  precioBs : Entero
  estado : EstadoAlmuerzo
}

enum OrigenAlmuerzo {
  ESPORADICO
  PENSION
}

enum EstadoAlmuerzo {
  CONFIRMADO
  CANCELADO
  INASISTENCIA_AVISADA
}

class Feriado {
  fecha : Fecha
  descripcion : Texto
}

class DescuentoTitular <<calculado>> {
  totalBs : Entero
}

class LineaDescuento <<calculado>> {
  modalidad : OrigenAlmuerzo
  cantidad : Entero
  precioUnitarioBs : Entero
  subtotalBs : Entero
}

Persona <|-- Empleado
Persona <|-- Familiar
Empleado "1" o-- "0..*" Familiar : tiene a cargo >
Empleado "1" --> "0..1" Autorizacion : tiene >
Autorizacion --> Rol
Empleado "1" --> "0..*" Sesion : abre >

Persona "1" --> "0..*" Almuerzo : consume >
Empleado "1" --> "0..*" Almuerzo : es titular del descuento >
Persona "1" --> "0..*" Pension : pensionada en >
Empleado "1" --> "0..*" Pension : solicita >
Pension "0..1" --> "0..*" Almuerzo : genera >
Almuerzo --> OrigenAlmuerzo
Almuerzo --> EstadoAlmuerzo

DescuentoTitular "1" *-- "1..*" LineaDescuento
DescuentoTitular ..> Almuerzo : se calcula desde
DescuentoTitular ..> Feriado : excluye

note bottom of Feriado
  Sin asociación con Almuerzo:
  un feriado significa que ese día
  no debe haber almuerzo que se cobre.
end note
@enduml
