@startuml clases
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 140
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam linetype ortho

skinparam class {
  BackgroundColor #F8FBFF
  BorderColor #1A5276
  HeaderBackgroundColor #D6EAF8
  FontSize 13
  AttributeFontSize 12
}

title Diagrama de clases\nSistema de Reservas y Pensionamiento de Almuerzos

class Empleado <<proyección externa>> {
  codigoInstitucional : Texto
  nombreCompleto : Texto
  activo : Booleano
}

class Autorizacion {
  rol : Rol
}

enum Rol {
  EMPLEADO
  ENCARGADO
}

class Pension {
  anio : Entero
  mes : Entero
  fechaSolicitud : Fecha
}

class Almuerzo {
  fecha : Fecha
  origen : OrigenAlmuerzo
  precioBs : Decimal
  estado : EstadoAlmuerzo
}

enum OrigenAlmuerzo {
  ESPORADICO
  PENSION
}

enum EstadoAlmuerzo {
  CONFIRMADO
  CANCELADO
  INASISTENCIA_AVISADA
}

class Feriado {
  fecha : Fecha
  descripcion : Texto
}

class LineaDescuento <<value object>> {
  codigoEmpleado : Texto
  nombre : Texto
  tipo : Texto
  cantidad : Entero
  precioUnitario : Decimal
  totalBs : Decimal
}

Empleado "1" --> "0..1" Autorizacion : tiene >
Autorizacion --> Rol
Empleado "1" --> "0..*" Pension : solicita >
Empleado "1" --> "0..*" Almuerzo : registra >
Pension "0..1" --> "0..*" Almuerzo : genera >
Almuerzo --> OrigenAlmuerzo
Almuerzo --> EstadoAlmuerzo

note bottom of Empleado
  No se da de alta en este sistema (R1b).
  No guarda contraseña ni «es pensionado».
end note

note bottom of Feriado
  Sin asociación a Almuerzo.
  Un feriado es un día en el que
  no debe existir un almuerzo confirmado.
end note

note bottom of LineaDescuento
  No se persiste.
  Se calcula al generar el reporte (HU08).
  La fuente de verdad es Almuerzo.
end note

note as INV
  **Invariantes**
  * Un empleado + una fecha = un almuerzo.
  * Un empleado + un mes = una pensión.
  * Esporádico = 18 Bs. Pensión = 15 Bs.
  * No hay almuerzo confirmado en feriado
    ni de viernes a domingo.
  * Solo el estado CONFIRMADO se cobra.
  * Avisar inasistencia no deja la pensión
    con menos de 10 confirmados en el mes.
end note
@enduml
