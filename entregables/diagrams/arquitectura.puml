@startuml arquitectura
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 150
skinparam roundcorner 10
skinparam ArrowColor #1A365D
skinparam ArrowThickness 1.4
skinparam rectangle {
  FontSize 14
  BorderColor #1A365D
}

title Capas del sistema de almuerzos (backlog v2)\nLa flecha es dependencia: quién conoce a quién

rectangle "Frontend del equipo\n(navegador)" as F #FFFFFF
rectangle "Presentación\nAPI GraphQL (/graphql): esquema y resolvers\nPantallas del servidor y descarga del reporte (Excel / PDF)\nLee el token. No calcula ni abre la base." as P #EAF3FB

rectangle "Aplicación\nUn caso de uso por historia (HU01 a HU12)\nOrdena los pasos y verifica quién puede hacerlos." as A #EAF6EA

rectangle "Dominio\nEntidades: Persona, Almuerzo, Pension, Feriado\nReglas R1 a R12: 9:00, lunes a jueves, 18 / 15 Bs, tope, mínimo de 10, descuento\nPuertos: repositorios, SistemaEmpresarial, Reloj, Tokens, ExportadorReporte" as D #FFF8E8

rectangle "Infraestructura\nRepositorios Prisma · cliente HTTP de la API empresarial (5 s)\nReloj America/La_Paz · tokens · exportador Excel · exportador PDF\nComposición: único lugar que crea las clases concretas" as I #F6EEF8

database "PostgreSQL\n(local o Supabase)\nRLS activo" as DB #E8EEF6
rectangle "API del sistema\nempresarial (TI)\nsolo lectura" as EXT #FFFFFF

F -down-> P : GraphQL + Bearer token
P -down-> A : llama a los casos de uso
A -down-> D : usa entidades, reglas y puertos
I -up-> D : implementa los puertos\n(el dominio no la conoce)
I -down-> DB : Prisma
I -right-> EXT : HTTPS

note right of D
  DIP: la política no depende del detalle.
  No hay repositorio para la tarifa
  ni para la línea de descuento.
  El reporte se calcula; no se guarda.
end note
@enduml
