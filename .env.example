# Copiar a .env (que no se sube a Git) y completar.

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Local: la misma URL en las dos variables.
DATABASE_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/almuerzos?schema=public"
DIRECT_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/almuerzos?schema=public"

# Supabase (Project Settings > Database > Connection string):
#   DATABASE_URL -> "Transaction pooler", puerto 6543, agregar ?pgbouncer=true
#   DIRECT_URL   -> "Session pooler", puerto 5432 (la usan las migraciones).
#                   No usar "Direct connection" (db.xxx.supabase.co): en el plan gratis es solo IPv6
#                   y desde la mayoría de las redes falla con P1001.
# DATABASE_URL="postgresql://postgres.REF:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.REF:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Datos iniciales (npm run preparar) --------------------------------------
# true: usuarios de prueba (contraseña Demo2026), menús del mes y una pensión de ejemplo.
SEMBRAR_DEMO=true
# Sin demo: primer administrador que se crea si no hay ninguno (R3). Debe cambiar la contraseña al entrar.
# ADMIN_USUARIO=admin
# ADMIN_CONTRASENA=Admin2026

# --- Servidor -----------------------------------------------------------------
PORT=3000
# Orígenes de un frontend aparte que llama a /graphql desde el navegador, separados por coma.
CORS_ORIGENES="http://localhost:5173,http://localhost:3001"
# Interfaz para probar consultas en /graphql. Por defecto activa fuera de producción.
# GRAPHIQL=true
# Fija la hora de Bolivia para probar la regla de las 9:00: AAAA-MM-DDTHH:MM
# RELOJ_FIJO=2026-10-07T08:30

# Prueba de integración contra PostgreSQL (opcional). Base vacía y aparte: la prueba borra sus tablas.
# DATABASE_URL_PRUEBAS="postgresql://postgres:CONTRASEÑA@localhost:5432/almuerzos_pruebas?schema=public"
